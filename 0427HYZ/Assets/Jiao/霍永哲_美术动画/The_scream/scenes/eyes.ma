relationship "shadowLink" ":lightLinker1" "eye_cornea_leftSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "eye_lens_leftSG.message" ":defaultLightSet.message";
connectAttr "layerManager.dli[0]" "defaultLayer.id";
connectAttr "renderLayerManager.rlmi[0]" "defaultRenderLayer.rlid";
