relationship "link" ":lightLinker1" "eye_lens_leftSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialShadingGroup.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" ":initialParticleSE.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "eye_caruncleSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "eye_lidSG.message" ":defaultLightSet.message";
relationship "shadowLink" ":lightLinker1" "eye_cornea_rightSG.message" ":defaultLightSet.message";
