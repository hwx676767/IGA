    - target: {fileID: 2751735736296460033, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u3010About Monthly Offline Meetups\u3011\n\r\nTo better maintain communication
        between members and keep things stable, offline meetups will be held regularly
        every month starting this month.\r\n\r\nTime: The third Sunday of each month\r\nLocation:
        Will be announced by the management team\r\nHow to join: Details will be
        sent after confirmation\r\n\r\nParticipants will be selected based on activity
        and recent status. Members who qualify will receive a message in advance,
        so please check your inbox.\r\nIf you do not receive a message, no need to
        worry. You can continue to join online.\r\n\r\nPlease arrange your time properly
        and attend as required.\r\n"
      objectReference: {fileID: 0}
