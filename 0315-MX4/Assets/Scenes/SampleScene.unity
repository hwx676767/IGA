      value: "\u7AD9\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 2751735736296460033, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u3010July Offline Meetup Notice \u2013 Edited\u3011\n\r\nDear members
        who have been looking forward to this:\r\nWe are sorry to inform you that
        due to some recent information and situations on the website, the planned
        offline meetup will be canceled for now and cannot be held as scheduled...\r\n\r\nThe
        site admin is currently checking and organizing the related content. Before
        things are clear, we do not suggest joining any unconfirmed offline events.\r\nPlease
        stay alert, protect your personal information and safety, and do not trust
        messages or invitations from unknown accounts.\r\n\r\nIf there are any updates,
        we will post them in the announcement section as soon as possible OwO.\r\n\r\nThank
        you for your understanding.\r\n"
      objectReference: {fileID: 0}
