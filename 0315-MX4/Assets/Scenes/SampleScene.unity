      value: "\u7AD9\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 2751735736296460033, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u3010About Recent Management Arrangements\u3011\n\r\nHello everyone,\r\nRecently
        I have been busy with personal matters and don\u2019t have enough time, so
        I may not be able to handle forum management as quickly as before.\r\n\r\nTo
        keep the website running normally, several trusted members will help manage
        things during this period. They will take care of tasks like content review
        and event planning. If you have any issues, you can contact the new management
        team first.\r\n\r\nThank you for your continued support. I hope the forum
        can keep a friendly and positive atmosphere under the management team.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 3191641678273846078, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
