    - target: {fileID: 1332869996995723780, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u7AD9\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 2751735736296460033, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u3010This Month\u2019s Offline Meetup Notice\u3011\n\r\nHello everyone,\r\nDue
        to popular demand, we\u2019re organizing a small meetup so that members who
        usually chat on the forum can meet in person. The event will be casual, mainly
        for chatting, sharing creations, and character settings. Some light snacks
        and free items will be provided by members\u2014feel free to help yourselves.
        Thank you for supporting our community~\r\n\r\nTime: Next Saturday, 14:00\r\nLocation:
        Central Area \xB7 Central Exchange Hall, Level 1 open space\r\nHow to join:
        Voluntary participation\r\n\r\nActivities include:\r\nCharacter setting sharing\r\nWork
        sharing\r\nFree discussion\r\nGroup photo (optional)\r\n\r\nIf you\u2019re
        interested, please leave a comment with the number of people so we can plan
        better. Looking forward to seeing everyone OwO\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3191641678273846078, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_SizeDelta.y
