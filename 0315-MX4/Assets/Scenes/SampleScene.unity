    - target: {fileID: 1332869996995723780, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u7AD9\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 2751735736296460033, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
      propertyPath: m_Text
      value: "\u3010March Offline Meetup Notice\u3011\n\r\nThanks for waiting!\r\nAfter
        three months, we\u2019ve finally decided to hold another meetup~ As usual,
        everyone is free to join and just have fun. Since it\u2019s midterm season,
        this meetup will be a bit smaller than the one during the summer holidays.
        Hope you understand > <\r\nWe\u2019ve also prepared some snacks and simple
        activities\u2014feel free to come and enjoy!\r\n\r\nTime: Next Saturday,
        14:00\r\nLocation: Central Area \xB7 Central Exchange Hall, Level 1 open
        space\r\nHow to join: Voluntary participation\r\n\r\nActivities include:\r\nCharacter
        setting sharing\r\nWork sharing\r\nFree discussion\r\nOn-site games\r\nFree
        item exchange (optional)\r\nGroup photo (optional)\r\n\r\nIf you\u2019re
        interested, please leave a comment with the number of people so we can plan
        better OwO\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3191641678273846078, guid: eeafd605329c524488d0efa3082ef60b, type: 3}
