      m_Calls: []
  m_text: "A young woman working part-time at the city library, claims to be studying
    English literature. She knows an unusual amount about the city\u2019s older neighborhoods,
    local institutions, and events that rarely appear in official records. Asking
    her the right question may lead to information that cannot be found in the catalogue."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ba3dc6ab6f31bb8409d644785b5d6e63, type: 2}
