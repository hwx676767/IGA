{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "870252ba8af14ab694d730f7de9ad70a",
    "m_Title": "去除Sprite外边缘几乎透明的像素",
    "m_Content": "1. 先用One Minus逆向颜色值，比如让0.1变成0.9\n2. 然后Substract用本身的色彩空间-逆向的色彩空间\n\t原本可视的区域会是 \t 1-0=1\n\t原本几乎透明的部分会是  0.1-0.9=-0.8\n\t原本就完全透明部分会是  0-1=-1\n3. 最后用Clamp，大于1的=1，小于0的=0",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -644.0,
        "y": -103.0,
        "width": 317.0,
        "height": 127.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

